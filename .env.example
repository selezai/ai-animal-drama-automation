# ═══════════════════════════════════════════════════════════════════
# AI Animal Drama — Environment Configuration (Budget Setup: $19/month)
# Copy to .env and fill in values. Also add these as GitHub Secrets.
# See MANUAL_TASKS.md for detailed setup instructions.
# ═══════════════════════════════════════════════════════════════════

# ── OpenAI (Script Generation) ────────────────────────────────────
# Get from: platform.openai.com/api-keys
# Cost: ~$0.002 per script (GPT-4o-mini)
OPENAI_API_KEY=sk-...

# ── ElevenLabs (Voice Generation - Budget) ────────────────────────
# Get from: elevenlabs.io → Profile → API Key
# Cost: $5/month Starter plan (30,000 characters)
# For Premium: See UPGRADE_TO_PREMIUM.md (Fish Audio $11/mo)
ELEVENLABS_API_KEY=...

# Character voice IDs — get from elevenlabs.io → My Voices
# Each voice ID looks like: 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_CHARLIE=
ELEVENLABS_VOICE_MILO=
ELEVENLABS_VOICE_BELLA=
ELEVENLABS_VOICE_DUKE=

# ── Luma Labs (Video Generation - Budget) ─────────────────────────
# Get from: lumalabs.ai/api → Dashboard → API Keys
# Cost: $0.24/video (Ray Flash 2, 720p)
# For Premium: See UPGRADE_TO_PREMIUM.md (Hailuo 02 Pro $0.48/video, 1080p)
LUMA_API_KEY=...

# Video model (optional, defaults to ray-flash-2)
LUMA_VIDEO_MODEL=ray-flash-2

# ── Facebook (Posting - FREE) ────────────────────────────────────
# See MANUAL_TASKS.md for detailed token setup instructions
FB_PAGE_ID=
FB_ACCESS_TOKEN=
