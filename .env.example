# AI Pet Tips Automation environment
# Copy this file to .env for local runs.
# Add the same values as GitHub Actions secrets for scheduled workflows.
# Never commit real API keys, tokens, app secrets, or credentials.

# OpenAI: script generation and scene prompt generation
OPENAI_API_KEY=

# ElevenLabs: narration generation
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini: image generation and comment replies
GOOGLE_API_KEY=
# Emergency-only: true allows local placeholder scene art when Gemini image generation is quota-blocked
ALLOW_FALLBACK_SCENES=

# Meta Graph API: Facebook Page posting and Instagram Reels
FB_PAGE_ID=
FB_ACCESS_TOKEN=
IG_USER_ID=

# Meta app credentials: token bootstrap/debug/refresh helpers
FB_APP_ID=
FB_APP_SECRET=
FB_LONG_LIVED_USER_TOKEN=

# Analytics feedback loop: blank/true enables weighting when score data exists; false disables it
ANALYTICS_WEIGHTING_ENABLED=
