# Generated output (except queue which needs to persist between runs)
output/scripts/
output/audio/
output/video/
output/final/
*.wav
.env
__pycache__/
*.pyc
.DS_Store
venv/
node_modules/
remotion/.cache/
bin/

# Keep queue JSON manifests (posted by daily-post workflow)
!output/queue/*.json

# Keep rendered videos referenced by queue
!output/video/*.mp4

# Ignore generated scenes and audio (regenerated by CI on each batch run)
remotion/public/scenes/
remotion/public/audio/
