# Generated output (except queue which needs to persist between runs)
output/scripts/
output/audio/
output/video/
output/final/
*.wav
.env
__pycache__/
*.pyc
.DS_Store
venv/
node_modules/
remotion/.cache/

# Keep queue JSON manifests (posted by daily-post workflow)
!output/queue/*.json

# Keep rendered videos referenced by queue
!output/video/*.mp4

# Keep audio files used by Remotion template
!remotion/public/audio/*.mp3
